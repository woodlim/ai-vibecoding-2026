# 실행 모드: PAPER에서는 실제 토스증권 주문 API를 호출하지 않습니다.
TRADING_MODE=PAPER

# PAPER 가상계좌 초기 현금 (KRW)
PAPER_INITIAL_CASH=10000000
AUTO_TRADE_INTERVAL_SECONDS=60

# 토스증권 Open API 자격 증명
# 실제 값은 .env 또는 Secret Manager에 저장하세요.
TOSS_CLIENT_ID=your_client_id_here
TOSS_CLIENT_SECRET=your_client_secret_here
TOSS_ACCOUNT_SEQ=your_account_seq_here

# 토스증권 API 주소
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_WS_URL=wss://openapi-ws.tossinvest.com/ws/v1

# 애플리케이션
APP_NAME=Toss Auto Trader
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# 저장소 (V0.1 기본값은 SQLite)
DATABASE_URL=sqlite:///./data/trader.db

# 기본 전략 대상 종목
DEFAULT_SYMBOL=005930
